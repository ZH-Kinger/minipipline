# multimodal_pipeline runtime configuration
#
# Copy this file to `.env` at the repo root and fill in environment-specific
# values. `.env` is git-ignored. Algorithm parameters live in
# multimodal_pipeline/config/*.py (and optional JSON overrides under
# examples/configs/). Only "real / environment-dependent / secret" values
# belong here.
#
# All variables are read at process start by multimodal_pipeline.config.settings.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
MMPIPE_DEVICE=cpu                       # cpu | cuda:0 | cuda:1 ...
MMPIPE_CACHE_DIR=~/.cache/mmpipe
MMPIPE_LOG_DIR=./logs
MMPIPE_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
MMPIPE_SEED=0
MMPIPE_DETERMINISTIC=true
MMPIPE_FFMPEG_PATH=                     # leave empty → look up via PATH
MMPIPE_FFPROBE_PATH=

# Default output root for `mmpipe <session>` (without explicit output arg).
# Handy on ECS/DSW when OSS is mounted at a fixed path:
#   MMPIPE_OUTPUT_ROOT=/mnt/oss-output/mmpipe
# Then `mmpipe /mnt/oss-input/session_xyz` writes to
#   /mnt/oss-output/mmpipe/session_xyz/
MMPIPE_OUTPUT_ROOT=

# ---------------------------------------------------------------------------
# Layer 2 backend selection (mock | real)
#
# All default to "mock". Setting one to "real" without wiring the real
# implementation will raise NotImplementedError at construction time.
# MMPIPE_HANDPOSE_BACKEND acts as a global default when a per-model value is
# not set.
# ---------------------------------------------------------------------------
MMPIPE_HANDPOSE_BACKEND=mock
MMPIPE_GEOCALIB_BACKEND=mock
MMPIPE_MOGE2_BACKEND=mock
MMPIPE_HAWOR_S1_BACKEND=mock
MMPIPE_MEGASAM_BACKEND=mock
MMPIPE_HAWOR_S2_BACKEND=mock

# ---------------------------------------------------------------------------
# Layer 1.5 annotator backends (mock | dashscope | local | rule_based)
# ---------------------------------------------------------------------------
MMPIPE_ANNOTATOR_BACKEND=mock           # umbrella default for the 3 below
MMPIPE_LANGUAGE_BACKEND=                # mock | dashscope | local
MMPIPE_ACTIONS_BACKEND=                 # mock | dashscope
MMPIPE_QUALITY_BACKEND=                 # mock | rule_based

# DashScope / Aliyun model service (when *_BACKEND=dashscope)
MMPIPE_DASHSCOPE_API_KEY=
MMPIPE_DASHSCOPE_MODEL=qwen2.5-vl-72b-instruct
MMPIPE_DASHSCOPE_ENDPOINT=              # optional, default dashscope.aliyuncs.com

# Per-model device overrides (fall back to MMPIPE_DEVICE when unset).
MMPIPE_GEOCALIB_DEVICE=
MMPIPE_MOGE2_DEVICE=
MMPIPE_HAWOR_S1_DEVICE=
MMPIPE_MEGASAM_DEVICE=
MMPIPE_HAWOR_S2_DEVICE=

# ---------------------------------------------------------------------------
# Layer 2 model weights paths
#
# Required when the corresponding *_BACKEND is set to "real". Ignored when
# the backend is "mock". Paths may use ~ for the home directory.
# ---------------------------------------------------------------------------
MMPIPE_GEOCALIB_WEIGHTS=
MMPIPE_MOGE2_WEIGHTS=
MMPIPE_HAWOR_S1_WEIGHTS=
MMPIPE_MEGASAM_WEIGHTS=
MMPIPE_HAWOR_S2_WEIGHTS=

# ---------------------------------------------------------------------------
# External services (optional)
# ---------------------------------------------------------------------------
MMPIPE_HF_TOKEN=                        # HuggingFace token (if downloading weights)
MMPIPE_S3_ENDPOINT=                     # object-storage upload target (future)
MMPIPE_S3_BUCKET=
MMPIPE_S3_ACCESS_KEY=
MMPIPE_S3_SECRET_KEY=
